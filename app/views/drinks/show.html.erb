<h1><%= @drink.name %></h1>

<p>
  現在の在庫：<strong><%= @drink.stock_ml %> ml</strong>
</p>

<p>
  <%= link_to "編集", edit_drink_path(@drink) %> |
  <%= button_to "削除", drink_path(@drink),
        method: :delete,
        data: { turbo_confirm: "削除しますか？" } %> |
  <% if @drink.stock_ml > 0 %>
    <%= link_to "このお酒を飲んだ",
        new_drink_drink_record_path(@drink) %>
  <% else %>
    在庫なし
  <% end %>
</p>

<hr>

<h2>飲酒履歴</h2>

<% if @drink_records.any? %>
<ul>
  <% @drink_records.each do |record| %>
    <li>
      <%= record.consumed_at.strftime("%Y-%m-%d %H:%M") %>
      ：<%= record.consumed_ml %> ml

      |
      <%= link_to "編集",
          edit_drink_drink_record_path(@drink, record) %>

      |
      <%= button_to "削除",
          drink_drink_record_path(@drink, record),
          method: :delete,
          data: { turbo_confirm: "削除しますか？" } %>
    </li>
  <% end %>
</ul>
<% else %>
  <p>まだ飲酒記録はありません。</p>
<% end %>

<p>
  <%= link_to "一覧に戻る", drinks_path %>
</p>
