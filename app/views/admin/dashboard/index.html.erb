<div class="admin-container">
  <div class="admin-header">
    <h1>管理者画面</h1>
    <p>DrinkStockの利用状況を確認できます。</p>
  </div>

  <div class="admin-stats">
    <div class="admin-stat-card">
      <p class="admin-stat-label">ユーザー数</p>
      <p class="admin-stat-number"><%= @users_count %></p>
    </div>

    <div class="admin-stat-card">
      <p class="admin-stat-label">お酒登録数</p>
      <p class="admin-stat-number"><%= @drinks_count %></p>
    </div>

    <div class="admin-stat-card">
      <p class="admin-stat-label">飲酒記録数</p>
      <p class="admin-stat-number"><%= @drink_records_count %></p>
    </div>

    <div class="admin-stat-card">
      <p class="admin-stat-label">お酒ログ数</p>
      <p class="admin-stat-number"><%= @drink_logs_count %></p>
    </div>
  </div>

  <div class="admin-menu">
    <%= link_to "ユーザー一覧", admin_users_path, class: "admin-menu-link" %>
    <%= link_to "在庫一覧", admin_drinks_path, class: "admin-menu-link" %>
    <%= link_to "飲酒記録一覧", admin_drink_records_path, class: "admin-menu-link" %>
    <%= link_to "お酒ログ一覧", admin_drink_logs_path, class: "admin-menu-link" %>
  </div>
</div>