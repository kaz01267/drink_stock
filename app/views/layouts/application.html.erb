<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DrinkStock" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% hide_nav = controller_name.in?(%w[sessions registrations passwords confirmations unlocks]) %>

    <% unless hide_nav %>
      <header class="header">
        <div class="container header__inner">
          <div class="header__brand">
            <%= link_to "DrinkStock", root_path, class: "header__logo" %>
          </div>

          <nav class="header__nav">
            <% if user_signed_in? %>
              <%= link_to "在庫一覧", drinks_path, class: "nav__link" %>
              <%= link_to "アカウント", account_path, class: "nav__link" %>
              <%= link_to "ログアウト",
                          destroy_user_session_path,
                          data: { turbo_method: :delete },
                          class: "nav__link nav__link--danger" %>
            <% else %>
              <%= link_to "ログイン", new_user_session_path, class: "nav__link" %>
              <%= link_to "新規登録", new_user_registration_path, class: "nav__link nav__link--primary" %>
            <% end %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="container">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
