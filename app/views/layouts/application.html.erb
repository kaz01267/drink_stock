<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DrinkStock" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% lp_page = controller_name == "pages" && action_name == "home" %>
    <% auth_page = controller_name.in?(%w[sessions registrations passwords confirmations unlocks]) %>

    <header class="header">
      <div class="container header__inner">
        <div class="header__brand">
          <%= link_to "DrinkStock", root_path, class: "header__logo" %>
        </div>

        <nav class="header__nav">
          <% if user_signed_in? %>
            <%= link_to "在庫一覧", drinks_path, class: "nav__link" %>
            <%= link_to "飲酒ログ", drink_records_path, class: "nav__link" %>
            <%= link_to "使い方", guide_path, class: "nav__link" %>
            <%= link_to "アカウント", account_path, class: "nav__link" %>
            <%= link_to "ログアウト",
                                   destroy_user_session_path,
                                   data: { turbo_method: :delete },
                                   class: "nav__link nav__link--danger" %>
          <% else %>
             <%= link_to "使い方", guide_path, class: "nav__link" %>
            <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>
    <footer class="container muted" style="padding-bottom: 24px;">
      <%= link_to "利用規約", terms_path %> /
      <%= link_to "プライバシーポリシー", privacy_path %>
    </footer>
  </body>
</html>