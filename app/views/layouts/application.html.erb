<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DrinkStock" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="DrinkStockは、家にあるお酒の在庫と飲酒記録をまとめて管理できるWebアプリです。">

    <meta property="og:title" content="DrinkStock">
    <meta property="og:description" content="家にあるお酒の在庫と飲酒記録をまとめて管理できるWebアプリです。">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://drink-stock.com">
    <meta property="og:image" content="<%= image_url('ogp.png') %>">
    <meta property="og:site_name" content="DrinkStock">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="DrinkStock">
    <meta name="twitter:description" content="家にあるお酒の在庫と飲酒記録をまとめて管理できるWebアプリです。">
    <meta name="twitter:image" content="<%= image_url('ogp.png') %>">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% lp_page = controller_name == "pages" && action_name == "home" %>
    <% auth_page = controller_name.in?(%w[sessions registrations passwords confirmations unlocks]) %>

    <header class="header">
      <div class="container header__inner">
        <div class="header__brand">
          <%= link_to "DrinkStock", root_path, class: "header__logo" %>
        </div>

        <nav class="header__nav">
          <% if user_signed_in? %>
            <%= link_to "ダッシュボード", dashboard_path, class: "nav__link" %>
            <%= link_to "在庫一覧", drinks_path, class: "nav__link" %>
            <%= link_to "飲酒履歴", drink_records_path, class: "nav__link" %>
            <%= link_to "お酒ログ", drink_logs_path, class: "nav__link" %>
            <%= link_to "使い方", guide_path, class: "nav__link" %>
            <%= link_to "アカウント", account_path, class: "nav__link" %>

            <% if current_user.admin? %>
              <%= link_to "管理者画面", admin_root_path, class: "nav__link" %>
            <% end %>

            <%= link_to "ログアウト",
                                   destroy_user_session_path,
                                   data: { turbo_method: :delete },
                                   class: "nav__link nav__link--danger" %>
          <% else %>
             <%= link_to "使い方", guide_path, class: "nav__link" %>
            <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>
    <footer class="container muted" style="padding-bottom: 24px;">
      <%= link_to "利用規約", terms_path %> /
      <%= link_to "プライバシーポリシー", privacy_path %>
    </footer>
  </body>
</html>