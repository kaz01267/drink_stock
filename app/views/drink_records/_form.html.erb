<%= form_with model: [drink, drink_record], local: true do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] %>

  <% if drink_record.errors.any? %>
    <div class="alert alert--danger">
      <ul>
        <% drink_record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form form--record">
    <div class="field">
      <%= f.label :consumed_ml, "飲んだ量(ml)", class: "field__label" %>
      <%= f.number_field :consumed_ml, min: 1, step: 1, class: "field__input", placeholder: "例: 350" %>
      <p class="help">在庫以内の量で記録してください。</p>

      <div class="record-tip">
        <p class="record-tip__title">💡 量の目安</p>
        <ul class="record-tip__list">
          <li>ビール1杯 ≒ 350ml</li>
          <li>ワイングラス1杯 ≒ 120ml</li>
          <li>日本酒1合 ≒ 180ml</li>
          <li>ウイスキー シングル ≒ 30ml / ダブル ≒ 60ml</li>
        </ul>
      </div>
    </div>

    <div class="field">
      <%= f.label :consumed_at, "飲んだ日", class: "field__label" %>
      <div class="field__datetime">
        <%= f.date_select :consumed_at, use_month_numbers: true %>
      </div>
    </div>

    <div class="actions actions--record">
      <%= f.submit "記録する", class: "btn btn--accent" %>
      <%= link_to "戻る", drink_path(drink), class: "btn" %>
    </div>
  </div>
<% end %>