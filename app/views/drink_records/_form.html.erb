<%= form_with model: [drink, drink_record], local: true do |f| %>
  <% if drink_record.errors.any? %>
    <div class="alert alert--danger">
      <ul>
        <% drink_record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form">
    <div class="field">
      <%= f.label :consumed_ml, "飲んだ量(ml)", class: "field__label" %>
      <%= f.number_field :consumed_ml, min: 1, step: 1, class: "field__input" %>
      <p class="help">在庫以内の量で記録してください。</p>

      <p class="help">
        💡 目安：
        ビール1杯 ≒ 350ml /
        ワイングラス1杯 ≒ 120ml /
        日本酒1合 ≒ 180ml /
        ウイスキー（シングル 30ml / ダブル 60ml）
      </p>
    </div>

    <div class="field">
      <%= f.label :consumed_at, "飲んだ日時", class: "field__label" %>
      <div class="field__datetime">
        <%= f.datetime_select :consumed_at, use_month_numbers: true %>
      </div>
    </div>

    <div class="actions">
      <%= f.submit class: "btn btn--accent" %>
      <%= link_to "戻る", drink_path(drink), class: "btn" %>
    </div>
  </div>
<% end %>
